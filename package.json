{
  "name": "portfolio-api",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "sanity exec scripts/migrate.ts --with-user-token --",
    "import-content": "sanity exec scripts/importContent.ts --with-user-token --"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.17.0",
    "easymde": "^2.18.0",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "react-is": "^19.2.2",
    "sanity": "^6.17.0",
    "sanity-plugin-markdown": "^9.0.14",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.0",
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
